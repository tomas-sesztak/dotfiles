{
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/herdr-agent-state.sh session",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh ~/.claude/hooks/tmux-agent-state.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "sh ~/.claude/hooks/tmux-agent-state.sh", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          { "type": "command", "command": "sh ~/.claude/hooks/tmux-agent-state.sh", "timeout": 5 }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          { "type": "command", "command": "sh ~/.claude/hooks/tmux-agent-state.sh", "timeout": 5 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(AskUserQuestion|ExitPlanMode)$",
        "hooks": [
          { "type": "command", "command": "sh ~/.claude/hooks/tmux-agent-state.sh", "timeout": 5 }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          { "type": "command", "command": "sh ~/.claude/hooks/tmux-agent-state.sh", "timeout": 5 }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "^(permission_prompt|elicitation_dialog)$",
        "hooks": [
          { "type": "command", "command": "sh ~/.claude/hooks/tmux-agent-state.sh", "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "sh ~/.claude/hooks/tmux-agent-state.sh", "timeout": 5 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "sh ~/.claude/hooks/tmux-agent-state.sh", "timeout": 5 }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "theme": "dark",
  "editorMode": "vim",
  "preferredNotifChannel": "auto",
  "terminalProgressBarEnabled": true,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true
}
